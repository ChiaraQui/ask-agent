# Google API Key (required for Gemini models)
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Supabase MCP credentials (required for Demo 2 and Demo 3)
# Generate a Personal Access Token at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=your_personal_access_token_here
SUPABASE_PROJECT_REF=your_project_ref_here

# Langfuse tracing (optional -- used by Demo 3 and the Streamlit app)
# Get keys at: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com  # uncomment only with real keys

# Gemini model. gemini-2.5-flash is unavailable to API keys created after ~2026;
# override here if you want a different one.
GEMINI_MODEL=gemini-3.8-flash
